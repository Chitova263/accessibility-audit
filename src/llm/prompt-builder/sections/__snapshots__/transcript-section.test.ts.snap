                    <properties level="2"/>
                </ax_node>
                <html_snippet><![CDATA[<h2>Pricing</h2>]]></html_snippet>
            </step>
        </steps>
    </strategy>
    <strategy name="tab" mode="focus">
        <description>Tab navigation</description>
        <completion_reason kind="cycle-complete">tab focus cycled through all elements</completion_reason>
        <steps total="1">
            <step index="0" id="tab-0">
                <spoken>Get Started, button</spoken>
                <item_text>Get Started</item_text>
