exports[`buildTranscriptSection > should handle real-world navigation transcript structure 1`] = `
"<transcript strategies="2" total_steps="7">
    <strategy name="landmark" mode="browse">
        <description>Navigates through ARIA landmarks using NVDA's landmark navigation (D key)</description>
        <completion_reason kind="exhausted">no more landmarks found on page</completion_reason>
        <steps total="4">
            <step index="0" id="banner-0">
                <spoken>banner landmark</spoken>
                <item_text>banner</item_text>
                <ax_node>
                    <role>banner</role>
                    <name/>
                </ax_node>
                <html_snippet><![CDATA[<header role="banner">...</header>]]></html_snippet>
            </step>
            <step index="1" id="nav-0">
                <spoken>navigation landmark Main Navigation</spoken>
                <item_text>Main Navigation</item_text>
                <ax_node>
                    <role>navigation</role>
                    <name>Main Navigation</name>
                </ax_node>
                <html_snippet><![CDATA[<nav aria-label="Main Navigation">...</nav>]]></html_snippet>
            </step>
            <step index="2" id="main-0">
                <spoken>main landmark</spoken>
                <item_text>main</item_text>
                <ax_node>
                    <role>main</role>
                    <name/>
                </ax_node>
                <html_snippet><![CDATA[<main>...</main>]]></html_snippet>
            </step>
            <step index="3" id="contentinfo-0">
                <spoken>content info landmark</spoken>
                <item_text>contentinfo</item_text>
                <ax_node>
                    <role>contentinfo</role>
                    <name/>
                </ax_node>
                <html_snippet><![CDATA[<footer>...</footer>]]></html_snippet>
            </step>
        </steps>
    </strategy>
    <strategy name="arrow" mode="browse">
        <description>Linear reading through page content using Down Arrow (browse mode)</description>
        <completion_reason kind="exhausted">reached end of document</completion_reason>
        <steps total="3">
            <step index="0" id="arrow-0">
                <spoken>link Homepage</spoken>
                <item_text>Homepage</item_text>
                <ax_node>
                    <role>link</role>
                    <name>Homepage</name>
                </ax_node>
                <html_snippet><![CDATA[<a href="/">Homepage</a>]]></html_snippet>
            </step>
            <step index="1" id="arrow-1">
                <spoken>heading level 1 Welcome</spoken>
                <item_text>Welcome</item_text>
                <ax_node>
                    <role>heading</role>
                    <name>Welcome</name>
                    <properties level="1"/>
                </ax_node>
                <html_snippet><![CDATA[<h1>Welcome</h1>]]></html_snippet>
            </step>
            <step index="2" id="arrow-2">
                <spoken>This is the introduction paragraph.</spoken>
                <item_text>This is the introduction paragraph.</item_text>
                <ax_node>
                    <role>StaticText</role>
                    <name>This is the introduction paragraph.</name>
                </ax_node>
                <html_snippet><![CDATA[<p>This is the introduction paragraph.</p>]]></html_snippet>
            </step>
        </steps>
    </strategy>
</transcript>"
`;

