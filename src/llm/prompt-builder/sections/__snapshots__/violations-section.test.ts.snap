    <rule id="button-name" wcag="4.1.2 A" impact="critical" count="2">
        <violation id="btn-1">
            <message>Buttons must have discernible text</message>
            <selector>#submit</selector>
        </violation>
        <violation id="btn-2">
            <message>Buttons must have discernible text</message>
            <selector>#cancel</selector>
        </violation>
    </rule>
    <rule id="link-name" wcag="4.1.2 A" impact="serious" count="1">
        <violation id="link-1">
            <message>Links must have discernible text</message>
            <selector>a.icon-link</selector>
        </violation>
    </rule>
</violations>"
`;

