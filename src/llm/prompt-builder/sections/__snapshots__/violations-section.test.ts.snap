exports[`buildViolationsSection > should build complete section from violations array 1`] = `
"<violations total="3" rules="3" critical="2" serious="1">
    <rule id="button-name" wcag="4.1.2 A" impact="critical" count="1">
        <violation id="v1">
            <message>Buttons must have discernible text</message>
            <selector>button.submit-btn</selector>
            <html_snippet><![CDATA[<button class="submit-btn"></button>]]></html_snippet>
            <transcript_match strategy="tab" step="5" confidence="low">
                <spoken>button</spoken>
            </transcript_match>
        </violation>
    </rule>
    <rule id="link-name" wcag="4.1.2 A" impact="critical" count="1">
        <violation id="v2">
            <message>Links must have text</message>
            <selector>button.submit-btn</selector>
            <html_snippet><![CDATA[<button class="submit-btn"></button>]]></html_snippet>
            <transcript_match strategy="tab" step="0" confidence="low">
                <spoken>Skip to main content, link</spoken>
            </transcript_match>
        </violation>
    </rule>
    <rule id="empty-accessible-name" wcag="4.1.2 A" impact="serious" count="1">
        <violation id="v3">
            <message>Button has no accessible name</message>
            <selector>button</selector>
            <html_snippet><![CDATA[<button></button>]]></html_snippet>
            <transcript_match strategy="tab" step="5" confidence="high">
                <spoken>button</spoken>
            </transcript_match>
        </violation>
    </rule>
</violations>"
`;

